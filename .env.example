# Application Port
PORT=5001
NODE_ENV=development

# Authentication & Security Secrets
JWT_SECRET=super_secret_jwt_key_institute_lms_production_change_me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Database Connection (Leave blank for persistent embedded local PostgreSQL; provide URL for dedicated server)
# DATABASE_URL=postgresql://user:password@localhost:5432/institute_lms?sslmode=disable
DATABASE_URL=

# Razorpay Payment Gateway Credentials (Phase 5)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Cloud Object Storage (Phase 3 & Phase 4 - Video DRM & Assets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=institute-lms-secure-content
