# ==============================================================================
# Apex Institute LMS - Production Environment Configuration Template
# Section 40 & 47: Production environment variables and secrets specification
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=5001

# PostgreSQL Dedicated Database Connection
DATABASE_URL=postgres://institute_admin:SuperSecretSecureDbPassword2026!@localhost:5432/institute_lms
POSTGRES_USER=institute_admin
POSTGRES_PASSWORD=SuperSecretSecureDbPassword2026!
POSTGRES_DB=institute_lms

# Security & JSON Web Tokens
# Generate with: openssl rand -base64 64
JWT_SECRET=prod_jwt_super_secret_key_institute_lms_2026_secure_do_not_share
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Client Origin (CORS & Cookie Domain)
CORS_ORIGIN=https://lms.institute.edu

# Razorpay Production Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_live_secret_key
RAZORPAY_WEBHOOK_SECRET=your_actual_live_webhook_secret

# Object Storage (AWS S3 / Cloudflare R2 / Google Cloud Storage)
# Section 28 & 30: Private bucket for video lectures and assets
STORAGE_PROVIDER=s3
STORAGE_BUCKET=institute-lms-secure-content
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Backup Configuration
BACKUP_DIR=/var/backups/institute_lms
RETENTION_DAYS=30
